{"insertText":{"location":{"index":144719,"tabId":"t.l5c18frq5wuo"},"text":"\nTable VIII presents the paired ROC-AUC differences between SwinFusion++ and each encoder."}},
{"updateParagraphStyle":{"range":{"startIndex":144720,"endIndex":144810,"tabId":"t.l5c18frq5wuo"},"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","alignment":"JUSTIFIED","lineSpacing":200,"indentFirstLine":{"magnitude":36,"unit":"PT"},"spaceAbove":{"magnitude":0,"unit":"PT"},"spaceBelow":{"magnitude":0,"unit":"PT"},"keepWithNext":false},"fields":"namedStyleType,alignment,lineSpacing,indentFirstLine,spaceAbove,spaceBelow,keepWithNext"}},
